# =====================================================================
# VoxFlow — environment configuration
#
# Copy to .env and fill in. NEVER commit the filled-in .env.
#   cp .env.example .env
#
# Every service below is hosted. Nothing runs on your local machine.
# SETUP.md explains where each value comes from, step by step.
# =====================================================================


# ---------------------------------------------------------------------
# 1. LLM — Groq (free tier)   https://console.groq.com
# ---------------------------------------------------------------------
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512

# Alternatives — leave blank unless you change LLM_PROVIDER.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b


# ---------------------------------------------------------------------
# 2. Speech-to-text — Groq hosted Whisper (free tier, server-side)
# ---------------------------------------------------------------------
# groq  = hosted, ~200-400ms, no local model. Reuses GROQ_API_KEY above.
# local = faster-whisper on this box. Needs requirements-local.txt and
#         ~2GB RAM. Offline development only.
STT_PROVIDER=groq
GROQ_STT_MODEL=whisper-large-v3-turbo

# Only used when STT_PROVIDER=local
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8


# ---------------------------------------------------------------------
# 3. Text-to-speech — edge-tts (free, calls Microsoft's cloud)
# ---------------------------------------------------------------------
#   hi-IN-SwaraNeural   (Hindi female)    hi-IN-MadhurNeural  (Hindi male)
#   en-IN-NeerjaNeural  (English female)  en-IN-PrabhatNeural (English male)
TTS_VOICE_HI=hi-IN-SwaraNeural
TTS_VOICE_EN=en-IN-NeerjaNeural
TTS_DEFAULT_LANG=hi


# ---------------------------------------------------------------------
# 4. Database — Supabase Postgres (free tier)
# ---------------------------------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the DIRECT connection (port 5432), NOT the transaction pooler: this is a
# long-running server, not a serverless function.
#
#   postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
#
# Leave as sqlite only for running the test suite locally.
DATABASE_URL=
SUPABASE_USE_POOLER=false

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=https://YOUR-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json


# ---------------------------------------------------------------------
# 5. Twilio — the only paid piece (~$1.15/mo + ~$0.013/min)
# ---------------------------------------------------------------------
# Twilio Console -> Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Public HTTPS address of THIS backend, no trailing slash.
#   e.g. https://voxflow.duckdns.org
# Used to build the <Stream> URL in TwiML and to validate webhook signatures.
# Signature validation WILL fail if this is wrong or missing behind a proxy.
PUBLIC_BASE_URL=

# Rejects forged/unsigned webhook requests. Keep true in production.
TWILIO_VALIDATE_SIGNATURE=true

# Fallback tenant when a dialed number isn't mapped in tenant_phone_numbers.
DEFAULT_TENANT_ID=varun


# ---------------------------------------------------------------------
# 6. Google Sheets call log (free)
# ---------------------------------------------------------------------
SHEETS_ENABLED=true

# The entire service-account JSON on ONE line, wrapped in single quotes.
# SETUP.md step 5 shows how to flatten the downloaded file.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Alternative to the above: a path to the JSON inside the container.
# GOOGLE_SERVICE_ACCOUNT_FILE=/app/service-account.json

# From your spreadsheet URL:
#   docs.google.com/spreadsheets/d/<THIS-PART>/edit
GOOGLE_SHEET_ID=

# Tab name inside that spreadsheet. Headers are written on first use.
GOOGLE_SHEET_TAB=Call Log


# ---------------------------------------------------------------------
# 7. API
# ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Your Vercel dashboard URL. Comma-separate multiple origins.
API_CORS_ORIGINS=https://voxflow-voice-agent.vercel.app,http://localhost:3000

LOG_LEVEL=INFO

BUSINESS_NAME=VoxFlow
BUSINESS_TIMEZONE=Asia/Kolkata


# ---------------------------------------------------------------------
# 8. Caddy / TLS — used by deploy/docker-compose.prod.yml
# ---------------------------------------------------------------------
# Public hostname, without https://
DOMAIN=voxflow.duckdns.org
# Let's Encrypt sends certificate-expiry notices here.
ACME_EMAIL=you@example.com

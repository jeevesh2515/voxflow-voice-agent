# =====================================================================
# VoxFlow — environment configuration
#
# Copy to .env and fill in. NEVER commit the filled-in .env.
#   cp .env.example .env
#
# Every service below is hosted. Nothing runs on your local machine.
# SETUP.md explains where each value comes from, step by step.
# =====================================================================


# ---------------------------------------------------------------------
# 1. LLM — Groq (free tier)   https://console.groq.com
# ---------------------------------------------------------------------
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Fallback model when the primary exhausts its retry budget on a 429 (Day 43).
# Must be a DIFFERENT model your key can actually reach: Groq meters each model
# in its own rate-limit bucket, so a fallback equal to the primary re-enters the
# bucket that is already throttling, and a model your account lacks returns 404 —
# turning a recoverable rate-limit into a failed call turn. Verify entitlement
# with a one-off chat/completions call before changing this.
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512

# Alternatives — leave blank unless you change LLM_PROVIDER.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b


# ---------------------------------------------------------------------
# 2. Speech-to-text — Groq hosted Whisper (free tier, server-side)
# ---------------------------------------------------------------------
# groq  = hosted, ~200-400ms, no local model. Reuses GROQ_API_KEY above.
# local = faster-whisper on this box. Needs requirements-local.txt and
#         ~2GB RAM. Offline development only.
STT_PROVIDER=groq
GROQ_STT_MODEL=whisper-large-v3-turbo

# Only used when STT_PROVIDER=local
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8


# ---------------------------------------------------------------------
# 3. Text-to-speech — edge-tts (free, calls Microsoft's cloud)
# ---------------------------------------------------------------------
# Browser simulator only. Real phone calls are spoken by Amazon Polly, whose
# voice is set in the Connect contact flow (deploy/aws/connect-contact-flow.json
# -> SetVoiceAction: Amy / en-GB).
#   en-GB-SoniaNeural   (English UK female)  en-GB-RyanNeural   (English UK male)
#   hi-IN-SwaraNeural   (Hindi female)       hi-IN-MadhurNeural (Hindi male)
TTS_VOICE_HI=hi-IN-SwaraNeural
TTS_VOICE_EN=en-GB-SoniaNeural
TTS_DEFAULT_LANG=en


# ---------------------------------------------------------------------
# 4. Database — Supabase Postgres (free tier)
# ---------------------------------------------------------------------
# Supabase dashboard -> Connect -> "Session pooler"
#
# USE THE SESSION POOLER, not the direct connection:
#   direct  db.<ref>.supabase.co:5432                  IPv6-ONLY -> unreachable
#           from an IPv4 host or ANY Docker container. Fails with
#           OSError: [Errno 101] Network is unreachable.
#   session aws-<region>.pooler.supabase.com:5432      <- THIS ONE. IPv4,
#           session mode, supports prepared statements.
#   txn     aws-<region>.pooler.supabase.com:6543      transaction mode, no
#           prepared statements, for serverless only.
#
# The pooler username is TENANT-QUALIFIED: postgres.<project-ref>
#
#   postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
#
# Leave as sqlite only for running the test suite locally.
DATABASE_URL=

# DEPRECATED and ignored. Put the full pooler URL in DATABASE_URL above.
SUPABASE_USE_POOLER=false

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=https://YOUR-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json
# Day 43: Symmetric encryption passphrase for nightly pg_dump backups (never commit actual key)
BACKUP_ENCRYPTION_KEY=
DB_BACKUP_KEEP_DAYS=7


# ---------------------------------------------------------------------
# 5. Telephony Provider (Amazon Connect AWS Voice Contact Center)
# ---------------------------------------------------------------------
TELEPHONY_PROVIDER=connect

# ----- Amazon Connect (AWS Free Tier - 90 min/mo) -----
CONNECT_LAMBDA_SECRET=
CONNECT_INSTANCE_ID=voxflow-agent
CONNECT_LAMBDA_ARN=
CONNECT_PHONE_NUMBER=+44XXXXXXXXXX
CONNECT_REGION=us-west-2

# ----- AWS Lambda bridge env vars (set in AWS, NOT read from this file) -----
# deploy/aws/lambda_handler.py runs inside AWS Lambda and reads its own env:
#   VOXFLOW_API_URL      = https://<your-domain>        (this backend, always-on VM)
#   VOXFLOW_SECRET       = the SAME value as CONNECT_LAMBDA_SECRET above
#                          (the API verifies the HMAC with it — a mismatch is a 403)
#   VOXFLOW_DEFAULT_LANG = en                           (UK-English first market)
# Ship code + config together:  ./deploy/aws/deploy-lambda.sh
#
# ----- Amazon Lex V2 (speech-to-text front door for phone calls) -----
# The contact flow's GetCustomerSpeech block needs a Lex bot alias ARN. Lex only
# transcribes; VoxFlow's AgentRunner is the brain. See deploy/aws/LEX_SETUP.md.
CONNECT_LEX_BOT_ALIAS_ARN=

# Public HTTPS address of THIS backend, no trailing slash.
#   e.g. https://voxflow-jeevesh.duckdns.org
PUBLIC_BASE_URL=

# Fallback tenant when a dialed number isn't mapped in tenant_phone_numbers.
DEFAULT_TENANT_ID=varun

# Provider callback lifecycle (Day 32)
# Leave the secret blank until the provider adapter is explicitly configured.
# With validation enabled and no secret, callback ingestion fails closed (503).
PROVIDER_CALLBACK_SHARED_SECRET=
PROVIDER_CALLBACK_VALIDATE_SIGNATURE=true
PROVIDER_CALLBACK_MAX_AGE_SECONDS=300

# Day 33 Dial sandbox adapter. Do not enable or configure a provider subscription
# in production until documented sandbox fixtures and rollback drills are approved.
# The current and optional previous Dial webhook signing secrets may be comma-separated
# only during an explicit rotation overlap. Never expose either secret to the dashboard.
DIAL_CALLBACK_ADAPTER_ENABLED=false
DIAL_CALLBACK_SANDBOX_MODE=true
DIAL_CALLBACK_ALLOWED_TENANTS=
DIAL_CALLBACK_SIGNING_SECRETS=
DIAL_CALLBACK_MAX_AGE_SECONDS=300

# Day 35 controlled-pilot readiness. The campaign gate remains fail-closed until
# a named, tenant-specific approval has been reviewed. This never starts a worker.
PILOT_READINESS_ENFORCED=true
PILOT_READINESS_APPROVED_TENANTS=

# Day 36 evidence-led pilot operations. A named pilot must also have fresh,
# redacted same-cohort preflight/hold-point evidence before a future dispatch
# can be admitted. This gate never starts a worker or expands a cohort.
PILOT_OPERATIONS_EVIDENCE_ENFORCED=true

# Day 34 durable operational side effects. This independent worker owns
# Sheets mirrors, email scans, CRM webhooks, notifications, and recordings.
# Keep it disabled and dry-run until Day 35 pilot authorization is approved.
DURABLE_SIDE_EFFECTS_WORKER_ENABLED=false
DURABLE_SIDE_EFFECTS_DRY_RUN=true
DURABLE_SIDE_EFFECTS_ALLOWED_TENANTS=
DURABLE_SIDE_EFFECTS_MAX_CONCURRENCY=1
DURABLE_SIDE_EFFECTS_POLL_INTERVAL_SECONDS=2.0


# ---------------------------------------------------------------------
# 5b. Stripe billing (Day 53) — Checkout, Customer Portal, webhooks
# ---------------------------------------------------------------------
# Every secret is resolved from the environment only; nothing is committed.
# When STRIPE_SECRET_KEY is blank the billing service runs in a deterministic
# sandbox — no network calls, HMAC-signed webhooks — so tests and local dev work
# without a Stripe account. Set the three live keys to charge real cards.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=whsec_...
# One price ID per tier, from Stripe Dashboard → Products → Prices. Blank falls
# back to inline price_data (GBP) so a partially configured deploy still bills.
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_ENTERPRISE=price_...
# Metered (usage-based) price IDs for per-call-minute overage billing:
STRIPE_METER_PRICE_STARTER=
STRIPE_METER_PRICE_GROWTH=
STRIPE_METER_PRICE_ENTERPRISE=
STRIPE_METER_EVENT_NAME=voxflow_voice_minutes
# Where Stripe redirects after checkout / portal. Must be absolute http(s) URLs.
BILLING_PORTAL_RETURN_URL=http://localhost:3000/dashboard/settings
BILLING_TRIAL_PERIOD_DAYS=14

# ---------------------------------------------------------------------
# 6. Google Sheets call log (free) — OPTIONAL, safe to defer
# ---------------------------------------------------------------------
# Leave this false to deploy and make real calls NOW without Google Sheets.
# Call outcomes still get captured in full (reason, solution, resolution,
# satisfaction) and still persist to Postgres and the dashboard — Sheets is a
# human-facing mirror, not the source of truth. Flip to true once you have
# completed SETUP.md step 5; no code change or rebuild of the app is needed,
# just `docker compose ... up -d` to reload the env.
SHEETS_ENABLED=false

# The entire service-account JSON on ONE line, wrapped in single quotes.
# SETUP.md step 5 shows how to flatten the downloaded file.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Alternative to the above: a path to the JSON inside the container.
# GOOGLE_SERVICE_ACCOUNT_FILE=/app/service-account.json

# From your spreadsheet URL:
#   docs.google.com/spreadsheets/d/<THIS-PART>/edit
GOOGLE_SHEET_ID=

# Tab name inside that spreadsheet. Headers are written on first use.
GOOGLE_SHEET_TAB=Call Log

# Day 42: per-tenant call-log mirroring. Comma-separated tenant IDs whose
# finished calls get exactly one Sheet row (written off the request path;
# Postgres stays the source of truth). Empty = no tenant is mirrored.
SHEETS_CALL_LOG_TENANTS=


# ---------------------------------------------------------------------
# 7. API
# ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Your Vercel dashboard URL. Comma-separate multiple origins.
API_CORS_ORIGINS=https://voxflow-voice-agent.vercel.app,http://localhost:3000

LOG_LEVEL=INFO

BUSINESS_NAME=VoxFlow
BUSINESS_TIMEZONE=Asia/Kolkata


# ---------------------------------------------------------------------
# 7.5. Storage & Persistence (Data Volumes)
# ---------------------------------------------------------------------
DATA_DIR=/app/data
SHEETS_RETRY_INTERVAL=60
LOG_RETENTION_DAYS=30
DB_BACKUP_KEEP_DAYS=7


# ---------------------------------------------------------------------
# 7.6. LangSmith — LLM Observability, Tracing & Evals
# ---------------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=voxflow-production
LANGSMITH_ENDPOINT=https://api.smith.langchain.com


# ---------------------------------------------------------------------
# 8. Caddy / TLS — used by deploy/docker-compose.prod.yml
# ---------------------------------------------------------------------
# Public hostname, without https://
DOMAIN=voxflow.duckdns.org
# Let's Encrypt sends certificate-expiry notices here.
ACME_EMAIL=you@example.com

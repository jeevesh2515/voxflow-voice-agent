{
  "Version": "2019-10-30",
  "StartAction": "SetVoiceAction",
  "Metadata": {
    "EntryPoints": {},
    "ActionMetadata": {
      "SetVoiceAction": { "Position": { "x": 120, "y": 80 } },
      "SetBargeInAttrs": { "Position": { "x": 340, "y": 80 } },
      "GetCustomerInputConsent": { "Position": { "x": 560, "y": 80 } },
      "InvokeLambdaConsent": { "Position": { "x": 800, "y": 80 } },
      "CompareConsent": { "Position": { "x": 1040, "y": 80 } },
      "SetRecordingOn": { "Position": { "x": 1260, "y": 40 } },
      "SetRecordingOff": { "Position": { "x": 1260, "y": 260 } },
      "PersistConsentTrue": { "Position": { "x": 1480, "y": 40 } },
      "PersistConsentFalse": { "Position": { "x": 1480, "y": 260 } },
      "PlayTurn1Reply": { "Position": { "x": 1700, "y": 80 } },
      "CheckEndCallTurn1": { "Position": { "x": 1920, "y": 80 } },
      "CheckEscalateTurn1": { "Position": { "x": 1920, "y": 280 } },
      "ConversationLoop": { "Position": { "x": 2140, "y": 80 } },
      "GetCustomerInputLoop": { "Position": { "x": 2380, "y": 80 } },
      "InvokeLambdaTurn": { "Position": { "x": 2620, "y": 80 } },
      "PlayAgentResponse": { "Position": { "x": 2860, "y": 80 } },
      "CheckEndCall": { "Position": { "x": 3100, "y": 80 } },
      "CheckEscalate": { "Position": { "x": 3100, "y": 280 } },
      "TransferToQueue": { "Position": { "x": 3340, "y": 280 } },
      "DisconnectCall": { "Position": { "x": 3340, "y": 80 } }
    }
  },
  "Actions": [
    {
      "Identifier": "SetVoiceAction",
      "Type": "UpdateContactData",
      "Parameters": {
        "Voice": "Amy",
        "LanguageCode": "en-GB"
      },
      "Transitions": { "NextAction": "SetBargeInAttrs", "Errors": [], "Conditions": [] }
    },
    {
      "Identifier": "SetBargeInAttrs",
      "Type": "UpdateContactAttributes",
      "Parameters": {
        "Attributes": {
          "x-amz-lex:barge-in-enabled": "true",
          "voxflow_turn": "0"
        }
      },
      "Transitions": { "NextAction": "GetCustomerInputConsent", "Errors": [], "Conditions": [] }
    },
    {
      "Identifier": "GetCustomerInputConsent",
      "Type": "ConnectParticipantWithLexBot",
      "Parameters": {
        "Text": "Hello, and welcome to VoxFlow. Please note that calls may be recorded for quality and training purposes. If you are happy to continue, tell me how I can help you.",
        "LexV2Bot": {
          "AliasArn": "arn:aws:lex:eu-west-2:YOUR_AWS_ACCOUNT_ID:bot-alias/YOUR_LEX_BOT_ID/YOUR_LEX_ALIAS_ID"
        },
        "LexTimeoutSeconds": { "Text": "45" }
      },
      "Transitions": {
        "NextAction": "InvokeLambdaConsent",
        "Errors": [
          { "NextAction": "InvokeLambdaConsent", "ErrorType": "InputTimeLimitExceeded" },
          { "NextAction": "InvokeLambdaConsent", "ErrorType": "NoMatchingCondition" },
          { "NextAction": "InvokeLambdaConsent", "ErrorType": "NoMatchingError" }
        ]
      }
    },
    {
      "Identifier": "InvokeLambdaConsent",
      "Type": "InvokeLambdaFunction",
      "Parameters": {
        "LambdaFunctionARN": "arn:aws:lambda:eu-west-2:YOUR_AWS_ACCOUNT_ID:function:VoxFlow-Connect-Bridge",
        "InvocationTimeLimitSeconds": "8",
        "Parameters": {
          "user_text": "$.Lex.InputTranscript",
          "turn": "1"
        }
      },
      "Transitions": {
        "NextAction": "CompareConsent",
        "Errors": [ { "NextAction": "CompareConsent", "ErrorType": "ExecutionError" } ]
      }
    },
    {
      "Identifier": "CompareConsent",
      "Type": "Compare",
      "Parameters": { "ComparisonValue": "$.External.consent_granted" },
      "Transitions": {
        "NextAction": "SetRecordingOff",
        "Conditions": [
          {
            "NextAction": "SetRecordingOn",
            "Condition": { "Operator": "Equals", "Operands": ["true"] }
          }
        ],
        "Errors": []
      }
    },
    {
      "Identifier": "SetRecordingOn",
      "Type": "UpdateContactRecordingBehavior",
      "Parameters": {
        "RecordingBehavior": {
          "RecordedParticipants": ["Agent", "Customer"],
          "ScreenRecordedParticipants": [],
          "IVRRecordingBehavior": "Enabled"
        }
      },
      "Transitions": { "NextAction": "PersistConsentTrue", "Errors": [] }
    },
    {
      "Identifier": "SetRecordingOff",
      "Type": "UpdateContactRecordingBehavior",
      "Parameters": {
        "RecordingBehavior": {
          "RecordedParticipants": [],
          "ScreenRecordedParticipants": [],
          "IVRRecordingBehavior": "Disabled"
        }
      },
      "Transitions": { "NextAction": "PersistConsentFalse", "Errors": [] }
    },
    {
      "Identifier": "PersistConsentTrue",
      "Type": "UpdateContactAttributes",
      "Parameters": {
        "Attributes": {
          "consent_recorded": "true",
          "consent_granted": "true"
        }
      },
      "Transitions": { "NextAction": "PlayTurn1Reply", "Errors": [], "Conditions": [] }
    },
    {
      "Identifier": "PersistConsentFalse",
      "Type": "UpdateContactAttributes",
      "Parameters": {
        "Attributes": {
          "consent_recorded": "false",
          "consent_granted": "false"
        }
      },
      "Transitions": { "NextAction": "PlayTurn1Reply", "Errors": [], "Conditions": [] }
    },
    {
      "Identifier": "PlayTurn1Reply",
      "Type": "MessageParticipant",
      "Parameters": { "Text": "$.External.agent_reply" },
      "Transitions": { "NextAction": "CheckEndCallTurn1", "Errors": [], "Conditions": [] }
    },
    {
      "Identifier": "CheckEndCallTurn1",
      "Type": "Compare",
      "Parameters": { "ComparisonValue": "$.External.end_call" },
      "Transitions": {
        "NextAction": "CheckEscalateTurn1",
        "Conditions": [
          {
            "NextAction": "DisconnectCall",
            "Condition": { "Operator": "Equals", "Operands": ["true"] }
          }
        ],
        "Errors": []
      }
    },
    {
      "Identifier": "CheckEscalateTurn1",
      "Type": "Compare",
      "Parameters": { "ComparisonValue": "$.External.escalate" },
      "Transitions": {
        "NextAction": "ConversationLoop",
        "Conditions": [
          {
            "NextAction": "TransferToQueue",
            "Condition": { "Operator": "Equals", "Operands": ["true"] }
          }
        ],
        "Errors": []
      }
    },
    {
      "Identifier": "ConversationLoop",
      "Type": "Loop",
      "Parameters": {
        "MaxIterations": "10",
        "LoopName": "conversation"
      },
      "Transitions": {
        "Looping": { "NextAction": "GetCustomerInputLoop" },
        "Complete": { "NextAction": "DisconnectCall" },
        "Error": { "NextAction": "DisconnectCall" }
      }
    },
    {
      "Identifier": "GetCustomerInputLoop",
      "Type": "ConnectParticipantWithLexBot",
      "Parameters": {
        "Text": "Is there anything else I can help you with?",
        "LexV2Bot": {
          "AliasArn": "arn:aws:lex:eu-west-2:YOUR_AWS_ACCOUNT_ID:bot-alias/YOUR_LEX_BOT_ID/YOUR_LEX_ALIAS_ID"
        },
        "LexTimeoutSeconds": { "Text": "30" }
      },
      "Transitions": {
        "NextAction": "InvokeLambdaTurn",
        "Errors": [
          { "NextAction": "InvokeLambdaTurn", "ErrorType": "InputTimeLimitExceeded" },
          { "NextAction": "InvokeLambdaTurn", "ErrorType": "NoMatchingCondition" },
          { "NextAction": "InvokeLambdaTurn", "ErrorType": "NoMatchingError" }
        ]
      }
    },
    {
      "Identifier": "InvokeLambdaTurn",
      "Type": "InvokeLambdaFunction",
      "Parameters": {
        "LambdaFunctionARN": "arn:aws:lambda:eu-west-2:YOUR_AWS_ACCOUNT_ID:function:VoxFlow-Connect-Bridge",
        "InvocationTimeLimitSeconds": "8",
        "Parameters": {
          "user_text": "$.Lex.InputTranscript",
          "turn": "$.Attributes.voxflow_turn"
        }
      },
      "Transitions": {
        "NextAction": "PlayAgentResponse",
        "Errors": [ { "NextAction": "PlayAgentResponse", "ErrorType": "ExecutionError" } ]
      }
    },
    {
      "Identifier": "PlayAgentResponse",
      "Type": "MessageParticipant",
      "Parameters": { "Text": "$.External.agent_reply" },
      "Transitions": { "NextAction": "CheckEndCall", "Errors": [], "Conditions": [] }
    },
    {
      "Identifier": "CheckEndCall",
      "Type": "Compare",
      "Parameters": { "ComparisonValue": "$.External.end_call" },
      "Transitions": {
        "NextAction": "CheckEscalate",
        "Conditions": [
          {
            "NextAction": "DisconnectCall",
            "Condition": { "Operator": "Equals", "Operands": ["true"] }
          }
        ],
        "Errors": []
      }
    },
    {
      "Identifier": "CheckEscalate",
      "Type": "Compare",
      "Parameters": { "ComparisonValue": "$.External.escalate" },
      "Transitions": {
        "NextAction": "ConversationLoop",
        "Conditions": [
          {
            "NextAction": "TransferToQueue",
            "Condition": { "Operator": "Equals", "Operands": ["true"] }
          }
        ],
        "Errors": []
      }
    },
    {
      "Identifier": "TransferToQueue",
      "Type": "TransferToQueue",
      "Parameters": {},
      "Transitions": { "NextAction": "DisconnectCall", "Errors": [], "Conditions": [] }
    },
    {
      "Identifier": "DisconnectCall",
      "Type": "DisconnectParticipant",
      "Parameters": {},
      "Transitions": {}
    }
  ]
}
